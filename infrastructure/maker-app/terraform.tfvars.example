# AWS Configuration
aws_region  = "us-east-1"
environment = "dev"

# Project Configuration
project_name = "monoatom-maker"

# GitHub Configuration
github_repository    = "https://github.com/roosterslab/monoatomlabs"
github_access_token  = "ghp_your_token_here"  # Store securely, don't commit
main_branch_name     = "maker-app"

# Branch Configuration
create_develop_branch          = false
enable_auto_branch_creation    = true
enable_branch_auto_build       = true
enable_branch_auto_deletion    = true
enable_pull_request_preview    = true
auto_branch_creation_patterns  = ["feature/*", "bugfix/*", "hotfix/*"]

# Domain Configuration (optional)
# domain_name   = "maker.monoatomlabs.com"
# domain_prefix = ""  # leave empty for root domain, or use subdomain like "app"

# Environment Variables for Build
environment_variables = {
  # VITE_API_URL = "https://api.example.com"
  # VITE_ENV     = "production"
}
